[Unit]
Description=Publish the AI-written roundup (every ROUNDUP_DAYS days)

[Timer]
# Fires every morning, after the hourly EA poll has picked up last night's
# games; weekly_article.py skips the days in between (ROUNDUP_DAYS, default
# every 2 days). A daily timer rather than "every other day" in systemd,
# which restarts its count each month and would post on the 31st and the 1st.
OnCalendar=*-*-* 09:15:00
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
