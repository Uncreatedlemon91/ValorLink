# Copy to proclubs/.env on the droplet. Loaded by config.py (python-dotenv).
# Deliberately separate from /opt/valorlink/.env -- this app shares no
# secrets with the bot/web app.

# --- Site identity ---------------------------------------------------------
SITE_NAME=Pr1mE6ers
SITE_TAGLINE=Pro Clubs

# --- Our club, for the locked-in stats dashboard (see tracked_clubs.json) --
CLUB_PLATFORM=common-gen5
CLUB_ID=7810354

# --- Discord OAuth2 (staff sign-in) -----------------------------------------
# Register a new application at https://discord.com/developers/applications
# (a separate app from the main ValorLink bot). Under OAuth2, add a redirect
# matching DISCORD_OAUTH_REDIRECT below, and note the client ID/secret.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT=https://proclubs.apps.valorlink.co/auth/discord/callback
# The team's Discord server ID, and the role ID that grants staff access
# there (Server Settings -> Roles, with Developer Mode on to copy IDs).
DISCORD_GUILD_ID=
DISCORD_STAFF_ROLE_ID=

# --- Twitch (streamer showcase) ---------------------------------------------
# Register a free app at https://dev.twitch.tv/console/apps -- any OAuth
# Redirect URL satisfies registration (this app only uses the app-level
# client-credentials grant, not user login), e.g. https://proclubs.apps.valorlink.co
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- Sessions -----------------------------------------------------------------
# Required in production: a long random string (e.g. `openssl rand -hex 32`).
SESSION_SECRET=
# Set to 1 once served over HTTPS (always true on the droplet, behind Caddy).
# Leave unset for local development over plain HTTP.
HTTPS_ONLY=1

# --- Local development only --------------------------------------------------
# Enables POST /auth/dev to sign in as any name/staff status without Discord.
# Never set this in production.
DEV_LOGIN=
