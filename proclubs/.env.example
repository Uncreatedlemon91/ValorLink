# Copy to proclubs/.env on the droplet. Loaded by config.py (python-dotenv).
# This is the site's only secrets file.

# --- Site identity ---------------------------------------------------------
SITE_NAME=YeeHaw FC
SITE_TAGLINE=Pro Clubs

# --- Our club, for the locked-in stats dashboard ---------------------------
# EA issues a new club ID every title -- the FC 26 club is not the FC 27
# club, even under the same name. Don't fill CLUB_ID in by hand: run
#
#   .venv/bin/python3 season.py find      # look the club up on EA
#   .venv/bin/python3 season.py switch    # set it here, erase old stats
#
# CLUB_NAME is what `find` searches for, as it's spelled in-game.
CLUB_NAME=Yeehaw FC
CLUB_PLATFORM=common-gen5
CLUB_ID=

# Max clubs shown on /league -- auto-built from real opponents (see
# README.md#the-league-table-auto-built-not-manually-curated), not manually
# curated. Once full, a newly-played opponent replaces whichever member has
# the fewest points. Higher = more EA API calls per poll (each league-table

# club is polled the same way our own club is).
LEAGUE_TABLE_MAX_TEAMS=25

# --- Discord OAuth2 (staff sign-in) -----------------------------------------
# From the club's Discord application (Developer Portal -> your app ->
# OAuth2). Add a redirect URI there matching DISCORD_OAUTH_REDIRECT below,
# then copy the client ID and secret here. Discord rejects a callback whose
# host doesn't match a registered redirect exactly, so the two must agree
# character for character.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT=https://yeehaw-fc.club/auth/discord/callback
# The team's Discord server ID -- only its members can use the site past
# the public splash page -- and a Discord role whose holders count as club
# management here (Server Settings -> Roles, with Developer Mode on to copy
# IDs). Club President / Head Coach / Coach are assigned on the site
# itself; this role is the way in for whoever sets them up.
DISCORD_GUILD_ID=
DISCORD_STAFF_ROLE_ID=
# Public invite link for that same server, shown to anyone who isn't a
# member yet (signed out, or signed in with Discord but not in the guild) --
# a banner site-wide, plus the "Connect with us" button on the home page.
# Not a secret; ships with a real default below, override if your invite
# link changes (Discord invites can expire/be regenerated).
DISCORD_INVITE_URL=https://discord.gg/J4d7D5kDX8

# --- Discord Scheduled Events sync (fixtures) -------------------------------
# One-directional: events scheduled in Discord get mirrored in as site
# fixtures automatically (a scheduled poll, not instant -- see
# deploy/README.md for the timer). Needs a bot token, which OAuth alone
# can't provide: Developer Portal -> your app -> Bot -> Reset Token.
#
# This is full bot access, not a scoped secret -- the most sensitive value
# in this file. Every Discord feature here reads it. Leave it blank to
# disable them all.
DISCORD_BOT_TOKEN=

# --- Discord clips sync (Clips page) ----------------------------------------
# One-directional, reuses DISCORD_BOT_TOKEN above: video files posted in one
# Discord channel get mirrored onto the site's Clips page (a scheduled poll,
# every 30 minutes -- see deploy/README.md). The ID of the channel to pull
# from -- enable Developer Mode in Discord, right-click the channel, "Copy
# Channel ID". The bot needs to be able to see that channel (View Channel +
# Read Message History). Leave blank to disable the Clips page entirely.
CLIPS_CHANNEL_ID=

# --- Discord article announcements -------------------------------------------
# One-directional, reuses DISCORD_BOT_TOKEN above: the moment an article goes
# live (published on creation, or a draft's first publish), a rich embed is
# posted in this channel linking back to it on the site -- not a poll, sent
# right when it happens. Leave blank to disable.
# --- Discord event sign-ups -------------------------------------------------
# The channel event announcements get posted to, with Going/Maybe/Can't
# make it buttons. Enable Developer Mode in Discord, right-click the
# channel, "Copy Channel ID".
EVENTS_ANNOUNCE_CHANNEL_ID=

# --- Staged event threads --------------------------------------------------
# Announce an event into its own PRIVATE thread in this channel instead of
# posting loose in EVENTS_ANNOUNCE_CHANNEL_ID. Each fixture then keeps its
# own conversation and its own audience. Blank = old behaviour.
EVENT_THREAD_CHANNEL_ID=
# Setting this is enough on its own -- you do NOT also need
# EVENTS_ANNOUNCE_CHANNEL_ID above. Either one gives the announcement
# somewhere to go; set both only if you want some events threaded and
# others posted loose.
#
# The invite ladder: who can see the thread, and when. Comma-separated
# `<when>:<role_id>`, where <when> is `create` (fires the moment staff
# announce the event) or a number of hours before kick-off. Each rung adds
# that role's members to the thread and pings them in it, so first pick
# goes to the first tier and the audience widens as the fixture nears:
#
#   EVENT_INVITE_TIERS=create:<role>,48:<role>,24:<role>
#
# NEEDS THE SERVER MEMBERS INTENT. Discord has no "list a role's members"
# route and threads carry no permissions of their own, so members are added
# to the thread one by one -- which means listing the guild's members,
# which is a privileged intent (Developer Portal -> Bot -> Server Members
# Intent). Without it each tier gets pinged but nobody gains access, which
# the poller warns about.
EVENT_INVITE_TIERS=
# Your Discord APPLICATION's public key (Developer Portal -> your app ->
# General Information -> Public Key). Used to verify that button presses
# really came from Discord. Not a secret -- it verifies a signature rather
# than authenticating us -- but sign-ups are refused without it, since an
# unverified endpoint would let anyone forge them.
#
# In the same portal, set Interactions Endpoint URL to
# https://yeehaw-fc.club/discord/interactions and save. Discord tests the
# URL as you save it and will reject it if the site isn't deployed yet, so
# do this after the deploy, not before.
DISCORD_PUBLIC_KEY=

NEWS_ANNOUNCE_CHANNEL_ID=

# The absolute https URL this site is reachable at -- required for the
# announcement above (an embed's url/image fields must be a real absolute
# URL, and it can't be reliably derived from a request behind Caddy without
# extra proxy-header trust this deploy doesn't set up). Leave blank and
# publishing still works, but skips the announcement (a flash message on
# publish will say so).
SITE_BASE_URL=https://yeehaw-fc.club

# How many of the most-recently-announced articles get their Discord
# reaction count refreshed each poll (proclubs-reactions-poll.timer, every
# 30 minutes -- see README.md#publishing-announces-to-discord). Every emoji
# is summed into one total, shown as a heart on the article page. No need
# to raise this much -- reactions settle quickly after posting.
DISCORD_REACTIONS_POLL_LIMIT=20

# --- Squad moves (Offer Position / Let Go) -----------------------------------
# Where /roster publishes an offer or a departure. Leave blank and it uses
# NEWS_ANNOUNCE_CHANNEL_ID above; set it to keep squad news out of the
# site-news channel.
#
# Reading the member list for the picker needs the bot's privileged
# GUILD_MEMBERS intent -- Developer Portal -> your app -> Bot -> Server
# Members Intent. That's a checkbox on Discord's side, not a setting here;
# without it /roster shows Discord's 403 instead of a member list.
#
ROSTER_ANNOUNCE_CHANNEL_ID=

# The role a player is given when they press ACCEPT on their own offer is
# the "Squad" role on the site's Discord roles page. This old setting is
# only read until that page is saved once.
# ROSTER_SQUAD_ROLE_ID=

# --- AI-written roundup -------------------------------------------------------
# Every ROUNDUP_DAYS days, weekly_article.py has Claude write up the results,
# player stats, standings and signings, and publishes it automatically
# (announced to Discord too, if the block above is set up). Runs the Claude
# Code CLI on a Claude subscription, not API credits -- see
# deploy/README.md for the one-time setup. Leave the token blank to disable.
CLAUDE_CODE_OAUTH_TOKEN=
# Absolute path to the CLI (systemd's PATH won't find a per-user install).
CLAUDE_BIN=/opt/valorlink/.local/bin/claude
# Optional: a model alias/name for the CLI's --model. Blank = its default.
CLAUDE_MODEL=
# The byline on these articles. Defaults to "SITE_NAME Desk".
WEEKLY_ARTICLE_AUTHOR=
# How often a roundup goes out, in days (each covers that many days).
# ROUNDUP_DAYS=2

# --- Twitch (streamer showcase) ---------------------------------------------
# Register a free app at https://dev.twitch.tv/console/apps -- any OAuth
# Redirect URL satisfies registration (this app only uses the app-level
# client-credentials grant, not user login), e.g. https://yeehaw-fc.club
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# A showcased streamer only counts as "live" if Twitch reports them playing
# this exact category -- live on some other game doesn't light up the site.
# Verify the exact name at twitch.tv/directory/category/<slug> if it ever
# looks wrong (a wrong string just makes everyone look offline, not an
# error). Leave blank to show anyone live regardless of game.
#
# This category name has not been verified against Twitch's live category
# page -- if everyone reads as offline while they're streaming, that's the
# first thing to check.
TWITCH_GAME_FILTER=EA Sports FC 27

# --- Sessions -----------------------------------------------------------------
# Required in production: a long random string (e.g. `openssl rand -hex 32`).
SESSION_SECRET=
# Set to 1 once served over HTTPS (always true on the droplet, behind Caddy).
# Leave unset for local development over plain HTTP.
HTTPS_ONLY=1

# --- Local development only --------------------------------------------------
# Enables POST /auth/dev to sign in as any name/staff status without Discord.
# Never set this in production.
DEV_LOGIN=

# Optional: the short code above every page title ("YFC / SQUAD") and the
# motto under the crest in the sidebar.
# SITE_SHORT=YFC
# SITE_MOTTO=Earn the shirt. Play the system.

# Match-week messages (notify_poll.py). Where the team sheet, the vote and
# the match report go when a fixture has no thread of its own -- falls
# back to EVENTS_ANNOUNCE_CHANNEL_ID, then NEWS_ANNOUNCE_CHANNEL_ID.
# MATCHDAY_CHANNEL_ID=
# NOTIFY_DMS=1      # 0 = no personal DMs (shirts, reminders, nudges)

# Discord roles the site manages (role_sync.py) are chosen by management on
# the site: Squad -> Discord roles. Nothing to set here. (Old ROLE_*_ID
# lines still work as a fallback until that page is saved once.)
